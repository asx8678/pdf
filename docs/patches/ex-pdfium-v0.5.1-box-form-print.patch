+// ── Page boundary boxes (write) ──────────────────────────────────────────────
+
+// Map a box-selector atom to its boundary box type. Unknown -> None (->
+// :unsupported_box). The Bounding ("BBox") box pdfium also exposes is computed
+// from page content rather than stored, so it is deliberately not selectable.
+fn boundary_box_type(name: Atom) -> Option<PdfPageBoundaryBoxType> {
+    Some(if name == atoms::media() {
+        PdfPageBoundaryBoxType::Media
+    } else if name == atoms::crop() {
+        PdfPageBoundaryBoxType::Crop
+    } else if name == atoms::bleed() {
+        PdfPageBoundaryBoxType::Bleed
+    } else if name == atoms::trim() {
+        PdfPageBoundaryBoxType::Trim
+    } else if name == atoms::art() {
+        PdfPageBoundaryBoxType::Art
+    } else {
+        return None;
+    })
+}
+
+/// Set one of a page's boundary boxes (`:media` | `:crop` | `:bleed` | `:trim` |
+/// `:art`) to the given rectangle, in PDF points. The read side is
+/// `document_page_info`.
+#[rustler::nif(schedule = "DirtyCpu")]
+#[allow(clippy::too_many_arguments)]
+fn document_set_page_box(
+    doc: ResourceArc<DocumentResource>,
+    page_index: u32,
+    box_type: Atom,
+    l: f64,
+    b: f64,
+    r: f64,
+    t: f64,
+) -> Result<Atom, Atom> {
+    let index = page_index_u16(page_index)?;
+    let box_type = boundary_box_type(box_type).ok_or_else(atoms::unsupported_box)?;
+    // A boundary box must be a real, non-degenerate rectangle: a zero-area box
+    // is invalid per the PDF spec and makes the page unrenderable in every
+    // consumer, so reject it here rather than write it and find out later.
+    if !valid_rect(l, b, r, t) || r <= l || t <= b {
+        return Err(atoms::bad_option());
+    }
+    with_pdfium(|_| {
+        let guard = doc.doc.lock().map_err(|_| atoms::lock_poisoned())?;
+        let document = guard.as_ref().ok_or_else(atoms::document_closed)?;
+        let mut page = document
+            .pages()
+            .get(index)
+            .map_err(|_| atoms::page_out_of_bounds())?;
+        // Like `set_rotation`, this writes page-dictionary metadata directly, so
+        // it persists into a later save with no content regeneration. pdfium
+        // re-derives the page size from the boxes on demand, so the already-open
+        // page reports and renders the new geometry immediately — verified: a
+        // render taken right after this call is byte-identical to one taken
+        // after a save and reopen.
+        page.boundaries_mut()
+            .set(box_type, pdf_rect(l, b, r, t))
+            .map_err(|_| atoms::set_box_failed())?;
+        Ok(atoms::ok())
+    })
+}
