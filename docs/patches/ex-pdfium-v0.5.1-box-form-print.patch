+// ── Forms (write) ────────────────────────────────────────────────────────────
+//
+// A widget is addressed the same way `document_delete_annotation` addresses one:
+// by 0-based annotation index within a page. `document_form_fields` reports that
+// index for every field it returns, so the read side feeds the write side.
+//
+// TWO PDFIUM BEHAVIOURS DECIDE WHETHER A WRITE ACTUALLY MEANS ANYTHING, and both
+// are silent, so both are handled explicitly here.
+//
+// 1. The write lands in the ANNOTATION's dictionary. That is the field itself
+//    only when the widget and its field are merged into one object — the usual
+//    shape for simple forms, but NOT what a generator emits when one field owns
+//    several widgets, where `/V` lives on a separate parent field object that
+//    pdfium reads and this write never reaches. pdfium reports no error; the
+//    value just does not take. So every write below is READ BACK through pdfium
+//    and a disagreement is returned as `:value_not_applied` rather than a silent
+//    no-op.
+//
+// 2. pdfium writes `/V` and does NOT regenerate the widget's `/AP` appearance
+//    stream, while `FPDFPage_Flatten` (our `flatten/1`) bakes `/AP` and ignores
+//    `/V`. Measured, not assumed:
+//
+//      * CHECKBOX — correct everywhere. Its appearances are pre-baked per state
+//        under `/AP /N` and pdfium switches the in-use state (`/AS`) with the
+//        value, so the new state renders AND flatten bakes it.
+//      * TEXT — the new value is drawn by `document_render_page` (pdfium's form
+//        layer builds the appearance from `/V`) whenever pdfium regenerates
+//        appearances, i.e. the AcroForm sets `/NeedAppearances true` or the
+//        widget has no `/AP`. With a stale `/AP` and no `/NeedAppearances`, even
+//        the render shows the old text. And `flatten/1` bakes the old text (or
+//        nothing) in BOTH cases — the form layer's generated appearance is not
+//        written back to `/AP`, so flattening never sees it.
+//
+//    Supplying an appearance stream ourselves would need font metrics and
+//    content-stream emission — out of scope for a binding — and pdfium's escape
+//    hatch for handing one over, `FPDFAnnot_SetAP`, is unreachable:
+//    `pdfium-render` 0.8.37 keeps every raw
+//    `FPDF_ANNOTATION`/`FPDF_PAGE`/`FPDF_DOCUMENT` handle `pub(crate)`, so the
+//    public `PdfiumLibraryBindings` trait has no argument to call it with.
+//
+// Radio buttons are deliberately absent: `PdfFormRadioButtonField::set_checked()`
+// in pdfium-render 0.8.37 takes the on-state name from the widget's CURRENT
+// `/AS` rather than its export value, so selecting an unselected button writes
+// the literal "Off". (It also prints two `println!` debug lines.) There is no
+// public path around it, so there is no correct radio write to expose yet.
+
+// Resolve the widget annotation at `annot_index` on a page and hand its form
+// field to `f`. Every form-field write goes through here, so the bounds check
+// and the "is this actually a form field?" check live in exactly one place.
+fn with_form_field(
+    doc: &ResourceArc<DocumentResource>,
+    page_index: u16,
+    annot_index: usize,
+    f: impl FnOnce(&mut PdfFormField) -> Result<(), Atom>,
+) -> Result<Atom, Atom> {
+    with_pdfium(|_| {
+        let guard = doc.doc.lock().map_err(|_| atoms::lock_poisoned())?;
+        let document = guard.as_ref().ok_or_else(atoms::document_closed)?;
+        let page = document
+            .pages()
+            .get(page_index)
+            .map_err(|_| atoms::page_out_of_bounds())?;
+        let annotations = page.annotations();
+        if annot_index >= annotations.len() {
+            return Err(atoms::annotation_not_found());
+        }
+        let mut annotation = annotations
+            .get(annot_index)
+            .map_err(|_| atoms::annotation_not_found())?;
+        let field = annotation
+            .as_form_field_mut()
+            .ok_or_else(atoms::not_a_form_field)?;
+        f(field)?;
+        Ok(atoms::ok())
+    })
+}
+
+/// Form filling: set a text field's value. See the section note above for when
+/// the new value renders and when a stale `/AP` still wins.
+#[rustler::nif(schedule = "DirtyCpu")]
+fn document_set_text_field_value(
+    doc: ResourceArc<DocumentResource>,
+    page_index: u32,
+    annot_index: u32,
+    value: String,
+) -> Result<Atom, Atom> {
+    let index = page_index_u16(page_index)?;
+    let annot_index = usize::try_from(annot_index).map_err(|_| atoms::annotation_not_found())?;
+    validate_string(&value)?;
+    with_form_field(&doc, index, annot_index, |field| {
+        let text = field
+            .as_text_field_mut()
+            .ok_or_else(atoms::wrong_field_type)?;
+        text.set_value(&value)
+            .map_err(|_| atoms::form_set_failed())?;
+        // Read back through pdfium (see note 1 above). pdfium reports an empty
+        // value as "no value", so an empty write reads back as None, not "".
+        if text.value().unwrap_or_default() == value {
+            Ok(())
+        } else {
+            Err(atoms::value_not_applied())
+        }
+    })
+}
+
+/// Form filling: check or clear a checkbox. pdfium switches the widget's in-use
+/// appearance state along with the value, so this survives `flatten/1`.
+#[rustler::nif(schedule = "DirtyCpu")]
+fn document_set_checkbox_value(
+    doc: ResourceArc<DocumentResource>,
+    page_index: u32,
+    annot_index: u32,
+    checked: bool,
+) -> Result<Atom, Atom> {
+    let index = page_index_u16(page_index)?;
+    let annot_index = usize::try_from(annot_index).map_err(|_| atoms::annotation_not_found())?;
+    with_form_field(&doc, index, annot_index, |field| {
+        let checkbox = field
+            .as_checkbox_field_mut()
+            .ok_or_else(atoms::wrong_field_type)?;
+        checkbox
+            .set_checked(checked)
+            .map_err(|_| atoms::form_set_failed())?;
+        if checkbox.is_checked().map_err(|_| atoms::form_failed())? == checked {
+            Ok(())
+        } else {
+            Err(atoms::value_not_applied())
+        }
+    })
+}
+
+// ── Composition: place a page on a page ──────────────────────────────────────
+
+/// Draw a copy of `src`'s page as a Form XObject on a page of `dest`, scaled to
+/// fill the `[left, bottom, right, top]` rectangle (PDF points). This is the
+/// underlay/overlay/n-up primitive: stationery, watermarks from a PDF, and
+/// imposition all reduce to it.
+///
+/// The source page's own box origin is shifted to the rectangle's corner, so a
+/// page whose CropBox does not start at (0, 0) lands where the caller asked.
+#[rustler::nif(schedule = "DirtyCpu")]
+#[allow(clippy::too_many_arguments)]
+fn document_place_page(
+    dest: ResourceArc<DocumentResource>,
+    dest_page_index: u32,
+    src: ResourceArc<DocumentResource>,
+    src_page_index: u32,
+    l: f64,
+    b: f64,
+    r: f64,
+    t: f64,
+) -> Result<Atom, Atom> {
+    // Same self-reference reasoning as `document_append`: one non-reentrant
+    // per-document mutex cannot be locked twice, and pdfium's XObject import
+    // needs `&mut` on the destination while the source is borrowed.
+    if std::ptr::eq(&*dest, &*src) {
+        return Err(atoms::same_document());
+    }
+    let dest_index = page_index_u16(dest_page_index)?;
+    let src_index = page_index_u16(src_page_index)?;
+    if !valid_rect(l, b, r, t) || r <= l || t <= b {
+        return Err(atoms::bad_option());
+    }
+    with_pdfium(|_| {
+        let mut dest_guard = dest.doc.lock().map_err(|_| atoms::lock_poisoned())?;
+        let src_guard = src.doc.lock().map_err(|_| atoms::lock_poisoned())?;
+        let dest_doc = dest_guard.as_mut().ok_or_else(atoms::document_closed)?;
+        let src_doc = src_guard.as_ref().ok_or_else(atoms::document_closed)?;
+        check_page(dest_doc, dest_index)?;
+        let src_page = src_doc
+            .pages()
+            .get(src_index)
+            .map_err(|_| atoms::page_out_of_bounds())?;
+
+        // The XObject reproduces the source page in the source page's OWN
+        // coordinate space. Take that space from the CropBox — what a viewer
+        // shows — falling back to the MediaBox, which pdfium does not do for us.
+        let source = src_page
+            .boundaries()
+            .crop()
+            .or_else(|_| src_page.boundaries().media())
+            .map_err(|_| atoms::page_info_failed())?
+            .bounds;
+        let (origin_x, origin_y) = (source.left().value as f64, source.bottom().value as f64);
+        let width = (source.right().value - source.left().value) as f64;
+        let height = (source.top().value - source.bottom().value) as f64;
+        if !valid_positive_f32(width) || !valid_positive_f32(height) {
+            return Err(atoms::page_info_failed());
+        }
+
+        let object = src_page
+            .objects()
+            .copy_into_x_object_form_object(dest_doc)
+            .map_err(|_| atoms::place_failed())?;
+
+        // Transforms compose in application order: move the source box origin to
+        // (0, 0), scale it to the target rectangle's size, then move it to the
+        // target rectangle's bottom-left corner.
+        attach_then_style(dest_doc, dest_index, object, |obj| {
+            obj.translate(
+                PdfPoints::new(-origin_x as f32),
+                PdfPoints::new(-origin_y as f32),
+            )
+            .map_err(|_| atoms::place_failed())?;
+            obj.scale(((r - l) / width) as f32, ((t - b) / height) as f32)
+                .map_err(|_| atoms::place_failed())?;
+            obj.translate(PdfPoints::new(l as f32), PdfPoints::new(b as f32))
+                .map_err(|_| atoms::place_failed())
+        })
+    })
+}
