<Layouts.workspace flash={@flash}>
  <div
    id="workspace-shell"
    phx-hook=".KeyboardShortcuts"
    phx-keydown="keydown"
    phx-keyup="keyup"
    tabindex="-1"
    aria-label="Workspace"
    aria-hidden={@backstage_open}
    class={if(@fullscreen, do: "fullscreen-mode")}
  >
    <.title_bar
      document_title={@document_title}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_save="save_document"
      on_save_as="save_document_as"
      on_email="open_email_compose"
    />
    <.menu_bar
      active_tab={@active_tab}
      on_tab_click="select_tab"
      on_hamburger_click="open_backstage"
      backstage_open={@backstage_open}
    />
    <.ribbon_strip active_tab={@active_tab} view_mode={@view_mode} />

    <.ocr_options_panel
      :if={@show_ocr_options}
      ocr_running={@ocr_running}
      ocr_progress={@ocr_progress}
    />

    <.document_tabs documents={@documents} active_id={@active_document_id} />

    <div class={[
      "flex flex-1 min-h-0 transition-all duration-200",
      if(@fullscreen, do: "fixed inset-0 z-50 bg-canvas dark:bg-gray-900")
    ]}>
      <.rail side="left" items={@left_items} on_item_click="toggle_panel" />
      <.side_panel
        :if={@left_panel}
        side="left"
        panel={@left_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        attachments={@attachments}
        signatures={@signatures}
        search_query={@search_query}
        search_results={@search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
      />

      <main
        id="document-canvas"
        phx-hook="PdfViewerHook SnapshotHook ReadAloudHook DocMutateHook"
        data-document-url={@document_url}
        data-snapshot-active={@snapshot_active}
        class="flex-1 min-w-0 relative overflow-hidden bg-canvas dark:bg-gray-900"
        aria-label="Document canvas"
        tabindex="0"
      >
        <div
          :if={!@document_url}
          class="absolute inset-0 flex items-center justify-center"
        >
          <.no_document_placeholder />
        </div>
        <%= if @split_view do %>
          <div class="absolute inset-0 flex divide-x divide-chrome-border dark:divide-gray-600">
            <div id="pdf-viewer-container-left" class="flex-1 overflow-auto"></div>
            <div id="pdf-viewer-container-right" class="flex-1 overflow-auto"></div>
          </div>
        <% else %>
          <div id="pdf-viewer-container" class="absolute inset-0 overflow-auto"></div>
        <% end %>

        <button
          :if={@fullscreen}
          type="button"
          phx-click="toggle_fullscreen"
          class="absolute top-4 right-4 z-50 p-2 bg-chrome-bg/90 backdrop-blur border border-chrome-border rounded-full hover:bg-chrome-bg transition-colors shadow-lg"
          aria-label="Exit fullscreen"
        >
          <.icon name="hero-arrows-pointing-in" class="size-4" />
        </button>

        <div
          :if={@read_aloud_active}
          class="absolute bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 bg-chrome-white dark:bg-gray-800 border border-chrome-border dark:border-gray-600 rounded-full px-4 py-2 shadow-lg"
          role="toolbar"
          aria-label="Read aloud controls"
        >
          <button
            type="button"
            phx-click="read_aloud_play"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Play"
          >
            <.icon name="hero-play" class="size-4" />
          </button>
          <button
            type="button"
            phx-click="read_aloud_pause"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Pause"
          >
            <.icon name="hero-pause" class="size-4" />
          </button>
          <button
            type="button"
            phx-click="read_aloud_stop"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Stop"
          >
            <.icon name="hero-stop" class="size-4" />
          </button>
          <span class="text-xs text-gray-400 dark:text-gray-500 ml-2">
            {if @read_aloud_playing, do: "Playing…", else: "Paused"}
          </span>
        </div>
      </main>

      <.side_panel
        :if={@right_panel}
        side="right"
        panel={@right_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        attachments={@attachments}
        signatures={@signatures}
        search_query={@search_query}
        search_results={@search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
      />
      <.rail side="right" items={@right_items} on_item_click="toggle_panel" />
    </div>

    <.status_bar
      :if={!@fullscreen}
      page={@page}
      total_pages={@total_pages}
      zoom={@zoom}
      rotation={@rotation}
      scroll_mode={@scroll_mode}
      spread_mode={@spread_mode}
      fit_mode={@fit_mode}
      split={@split_view}
      snapshot_active={@snapshot_active}
      read_aloud_active={@read_aloud_active}
      read_aloud_playing={@read_aloud_playing}
      progress={@progress}
    />

    <.confirm_close_modal :if={@confirm_close_doc} confirm_close_doc={@confirm_close_doc} />

    <.calibration_modal
      :if={@measure_modal_open}
      measure_modal_open={@measure_modal_open}
      calibrating={@calibrating}
      cal_known_length={@cal_known_length}
      cal_known_unit={@cal_known_unit}
      cal_drawn_points={@cal_drawn_points}
    />

    <.backstage
      open={@backstage_open}
      active_view={@backstage_view}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_select="backstage_select"
      on_close="close_backstage"
    />

    <.email_compose
      open={@show_email_compose}
      document_title={@document_title}
      on_close="close_email_compose"
      on_send="send_email"
    />

    <div
      :if={@whiteout_warning_visible}
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 max-w-lg w-full bg-amber-50 dark:bg-amber-900/80 border border-amber-300 dark:border-amber-700 rounded-xl shadow-xl p-4"
      role="alert"
      aria-live="polite"
    >
      <div class="flex items-start gap-3">
        <.icon
          name="hero-exclamation-triangle"
          class="size-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"
        />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-amber-800 dark:text-amber-200">
            Whiteout is cosmetic
          </p>
          <p class="text-xs text-amber-700 dark:text-amber-300 mt-1">
            Text underneath a whiteout is still extractable — this does not permanently remove content.
            Use <strong>Redact</strong> to permanently delete content from the document.
          </p>
          <div class="flex items-center gap-2 mt-3 flex-wrap">
            <button
              type="button"
              phx-click="switch_to_redact"
              class="px-3 py-1.5 text-xs font-medium bg-accent text-white rounded-lg hover:bg-accent/90 transition-colors cursor-pointer"
            >
              Redact instead
            </button>
            <button
              type="button"
              phx-click="dismiss_whiteout_permanently"
              class="px-3 py-1.5 text-xs text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-800 rounded-lg transition-colors cursor-pointer"
            >
              Don't show this warning again
            </button>
            <button
              type="button"
              phx-click="dismiss_whiteout_warning"
              class="px-3 py-1.5 text-xs text-amber-600 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-amber-800 rounded-lg transition-colors cursor-pointer"
            >
              Dismiss
            </button>
          </div>
        </div>
      </div>
    </div>

    <.shortcuts_modal :if={@show_shortcuts} on_close="close_shortcuts" />

    <script :type={Phoenix.LiveView.ColocatedHook} name=".KeyboardShortcuts">
      export default {
        mounted() {
          // Focus the shell so phx-keydown fires without the user clicking first
          this.el.focus();

          // Refocus the shell on any click outside form fields, so typing
          // in an input keeps its events while chrome shortcuts stay live
          document.addEventListener("click", (e) => {
            if (e.target.tagName !== "INPUT" && e.target.tagName !== "SELECT" && e.target.tagName !== "TEXTAREA") {
              this.el.focus();
            }
          });

          // The §8.5 keymap claims combos the browser reserves (⌘O/S/P,
          // ⌘F/G, zoom). Swallow the browser default when focus is not in
          // an editable element so the keypress reaches the server instead.
          const reserved = ["o", "s", "p", "f", "g", "z", "y", "a", "=", "+", "-", "0", "1"];
          document.addEventListener("keydown", (e) => {
            if (!(e.ctrlKey || e.metaKey)) return;
            if (!reserved.includes(e.key.toLowerCase())) return;
            if (e.target.closest("input, select, textarea, [contenteditable]")) return;
            e.preventDefault();
          }, true);
        }
      }
    </script>
  </div>
</Layouts.workspace>
