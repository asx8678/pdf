<Layouts.workspace flash={@flash}>
  <div
    id="workspace-shell"
    phx-hook=".KeyboardShortcuts"
    phx-keydown="keydown"
    phx-keyup="keyup"
    tabindex="-1"
    aria-label="Workspace"
    aria-hidden={@backstage_open}
  >
    <.title_bar
      document_title={@document_title}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_save="save_document"
      on_save_as="save_document_as"
      on_email="open_email_compose"
    />
    <.menu_bar
      active_tab={@active_tab}
      on_tab_click="select_tab"
      on_hamburger_click="open_backstage"
      backstage_open={@backstage_open}
    />
    <.ribbon_strip active_tab={@active_tab} view_mode={@view_mode} />
    <.document_tabs documents={@documents} active_id={@active_document_id} />

    <div class="flex flex-1 min-h-0">
      <.rail side="left" items={@left_items} on_item_click="toggle_panel" />
      <.side_panel
        :if={@left_panel}
        side="left"
        panel={@left_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        search_query={@search_query}
        search_results={@search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
      />

      <main
        id="document-canvas"
        phx-hook="PdfViewerHook"
        data-document-url={@document_url}
        class="flex-1 min-w-0 relative overflow-hidden bg-canvas dark:bg-gray-900"
        aria-label="Document canvas"
        tabindex="0"
      >
        <div
          :if={!@document_url}
          class="absolute inset-0 flex items-center justify-center"
        >
          <.no_document_placeholder />
        </div>
        <div
          id="pdf-viewer-container"
          class="absolute inset-0 overflow-auto"
        >
        </div>
      </main>

      <.side_panel
        :if={@right_panel}
        side="right"
        panel={@right_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        search_query={@search_query}
        search_results={@search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
      />
      <.rail side="right" items={@right_items} on_item_click="toggle_panel" />
    </div>

    <.status_bar
      page={@page}
      total_pages={@total_pages}
      zoom={@zoom}
      progress={@progress}
      on_prev_page="prev_page"
      on_next_page="next_page"
    />

    <.confirm_close_modal :if={@confirm_close_doc} confirm_close_doc={@confirm_close_doc} />

    <.backstage
      open={@backstage_open}
      active_view={@backstage_view}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_select="backstage_select"
      on_close="close_backstage"
    />

    <.email_compose
      open={@show_email_compose}
      document_title={@document_title}
      on_close="close_email_compose"
      on_send="send_email"
    />

    <.shortcuts_modal :if={@show_shortcuts} on_close="close_shortcuts" />

    <script :type={Phoenix.LiveView.ColocatedHook} name=".KeyboardShortcuts">
      export default {
        mounted() {
          // Focus the shell so phx-keydown fires without the user clicking first
          this.el.focus();

          // Refocus the shell on any click outside form fields, so typing
          // in an input keeps its events while chrome shortcuts stay live
          document.addEventListener("click", (e) => {
            if (e.target.tagName !== "INPUT" && e.target.tagName !== "SELECT" && e.target.tagName !== "TEXTAREA") {
              this.el.focus();
            }
          });

          // The §8.5 keymap claims combos the browser reserves (⌘O/S/P,
          // ⌘F/G, zoom). Swallow the browser default when focus is not in
          // an editable element so the keypress reaches the server instead.
          const reserved = ["o", "s", "p", "f", "g", "z", "y", "a", "=", "+", "-", "0", "1"];
          document.addEventListener("keydown", (e) => {
            if (!(e.ctrlKey || e.metaKey)) return;
            if (!reserved.includes(e.key.toLowerCase())) return;
            if (e.target.closest("input, select, textarea, [contenteditable]")) return;
            e.preventDefault();
          }, true);
        }
      }
    </script>
  </div>
</Layouts.workspace>
