<Layouts.workspace flash={@flash}>
  <div
    id="workspace-shell"
    phx-hook=".KeyboardShortcuts"
    phx-keydown="keydown"
    phx-keyup="keyup"
    tabindex="-1"
    aria-label="Workspace"
    aria-hidden={@backstage_open}
    class={if(@fullscreen, do: "fullscreen-mode")}
  >
    <%!-- LV 1.2.x phx-hook takes a single hook name — DownloadFile needs
         its own element (it only listens for push_events). --%>
    <div id="download-hook" phx-hook=".DownloadFile" class="hidden"></div>
    <.title_bar
      document_title={@document_title}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_save="save_document"
      on_save_as="save_document_as"
      on_email="open_email_compose"
      notifications_pending={Quire.Licensing.expiring_soon?(@current_scope)}
    />
    <.menu_bar
      active_tab={@active_tab}
      on_tab_click="select_tab"
      on_hamburger_click="open_backstage"
      backstage_open={@backstage_open}
    />
    <.ribbon_strip
      active_tab={@active_tab}
      view_mode={@view_mode}
      form_detect_running={@form_detect_running}
      form_detect_progress={@form_detect_progress}
      form_detections={@form_detections}
      clipboard_fallback={@clipboard_fallback}
      clipboard_fallback_msg={@clipboard_fallback_msg}
      show_new_menu={@show_new_menu}
      show_advanced_menu={@show_advanced_menu}
    />

    <.ocr_options_panel
      :if={@show_ocr_options}
      ocr_running={@ocr_running}
      ocr_progress={@ocr_progress}
    />

    <.document_tabs documents={@documents} active_id={@active_document_id} />

    <div class={[
      "flex flex-1 min-h-0 transition-all duration-200",
      if(@fullscreen, do: "fixed inset-0 z-50 bg-canvas dark:bg-gray-900")
    ]}>
      <.rail side="left" items={@left_items} on_item_click="toggle_panel" />
      <.side_panel
        :if={@left_panel}
        side="left"
        panel={@left_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        attachments={@attachments}
        signatures={@signatures}
        initials={@initials}
        search_query={@search_query}
        search_results={@streams.search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
      />

      <main
        id="document-canvas"
        phx-hook="WorkspaceCanvasHook"
        data-document-url={@document_url}
        data-snapshot-active={@snapshot_active}
        class="flex-1 min-w-0 relative overflow-hidden bg-canvas dark:bg-gray-900"
        aria-label="Document canvas"
        tabindex="0"
      >
        <div
          :if={!@document_url}
          class="absolute inset-0 flex items-center justify-center"
        >
          <.no_document_placeholder />
        </div>
        <%!--
          The PdfViewerHook (via WorkspaceCanvasHook) manages the DOM inside
          these containers (pdf.js page divs + canvases). Without
          phx-update="ignore" any LiveView patch morphs the container's
          children away and wipes the rendered document (Gate 2 / T-058).
        --%>
        <%= if @split_view do %>
          <div class="absolute inset-0 flex divide-x divide-chrome-border dark:divide-gray-600">
            <div id="pdf-viewer-container-left" phx-update="ignore" class="flex-1 overflow-auto">
            </div>
            <div id="pdf-viewer-container-right" phx-update="ignore" class="flex-1 overflow-auto">
            </div>
          </div>
        <% else %>
          <div
            id="pdf-viewer-container"
            phx-update="ignore"
            class="absolute inset-0 overflow-auto"
          >
          </div>
        <% end %>

        <div
          id="signature-placement-hint"
          class="hidden absolute top-4 left-1/2 -translate-x-1/2 z-40 px-4 py-2 rounded-lg bg-gray-900/85 text-white text-sm shadow-lg pointer-events-none"
          role="status"
        >
          Click the page to place the signature — drag to move, resize with the corners, then press
          <span class="font-semibold">Enter</span>
          or <span class="font-semibold">Place</span>.
        </div>

        <button
          :if={@fullscreen}
          type="button"
          phx-click="toggle_fullscreen"
          class="absolute top-4 right-4 z-50 p-2 bg-chrome-bg/90 backdrop-blur border border-chrome-border rounded-full hover:bg-chrome-bg transition-colors shadow-lg"
          aria-label="Exit fullscreen"
        >
          <.icon name="hero-arrows-pointing-in" class="size-4" />
        </button>

        <div
          :if={@read_aloud_active}
          class="absolute bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 bg-chrome-white dark:bg-gray-800 border border-chrome-border dark:border-gray-600 rounded-full px-4 py-2 shadow-lg"
          role="toolbar"
          aria-label="Read aloud controls"
        >
          <button
            type="button"
            phx-click="read_aloud_play"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Play"
          >
            <.icon name="hero-play" class="size-4" />
          </button>
          <button
            type="button"
            phx-click="read_aloud_pause"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Pause"
          >
            <.icon name="hero-pause" class="size-4" />
          </button>
          <button
            type="button"
            phx-click="read_aloud_stop"
            class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
            aria-label="Stop"
          >
            <.icon name="hero-stop" class="size-4" />
          </button>
          <span class="text-xs text-gray-400 dark:text-gray-500 ml-2">
            {if @read_aloud_playing, do: "Playing…", else: "Paused"}
          </span>
        </div>
      </main>

      <.side_panel
        :if={@right_panel}
        side="right"
        panel={@right_panel}
        pages={@thumbnails}
        page={@page}
        bookmarks={@bookmarks}
        layers={@layers}
        attachments={@attachments}
        signatures={@signatures}
        initials={@initials}
        search_query={@search_query}
        search_results={@streams.search_results}
        search_total={@search_total}
        search_current={@search_current}
        search_match_case={@search_match_case}
        search_whole_word={@search_whole_word}
        searching={@searching}
        translate_results={@translate_results}
      />
      <.rail side="right" items={@right_items} on_item_click="toggle_panel" />
    </div>

    <.status_bar
      :if={!@fullscreen}
      page={@page}
      total_pages={@total_pages}
      zoom={@zoom}
      rotation={@rotation}
      scroll_mode={@scroll_mode}
      spread_mode={@spread_mode}
      fit_mode={@fit_mode}
      split={@split_view}
      snapshot_active={@snapshot_active}
      read_aloud_active={@read_aloud_active}
      read_aloud_playing={@read_aloud_playing}
      progress={@progress}
    />

    <.confirm_close_modal :if={@confirm_close_doc} confirm_close_doc={@confirm_close_doc} />

    <.calibration_modal
      :if={@measure_modal_open}
      measure_modal_open={@measure_modal_open}
      calibrating={@calibrating}
      cal_known_length={@cal_known_length}
      cal_known_unit={@cal_known_unit}
      cal_drawn_points={@cal_drawn_points}
    />

    <.backstage
      open={@backstage_open}
      active_view={@backstage_view}
      dirty={Enum.any?(@documents, & &1.dirty)}
      on_select="backstage_select"
      on_close="close_backstage"
    />

    <.email_compose
      open={@show_email_compose}
      document_title={@document_title}
      on_close="close_email_compose"
      on_send="send_email"
    />

    <.esign_wizard
      open={@show_esign_wizard}
      step={@esign_wizard_step}
      signers={@esign_wizard_signers}
      fields={@esign_wizard_fields}
      subject={@esign_wizard_subject}
      message={@esign_wizard_message}
      expires_at={@esign_wizard_expires_at}
      sending={@esign_wizard_sending}
      error={@esign_wizard_error}
    />

    <div
      :if={@whiteout_warning_visible}
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 max-w-lg w-full bg-amber-50 dark:bg-amber-900/80 border border-amber-300 dark:border-amber-700 rounded-xl shadow-xl p-4"
      role="alert"
      aria-live="polite"
    >
      <div class="flex items-start gap-3">
        <.icon
          name="hero-exclamation-triangle"
          class="size-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"
        />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-amber-800 dark:text-amber-200">
            Whiteout is cosmetic
          </p>
          <p class="text-xs text-amber-700 dark:text-amber-300 mt-1">
            Text underneath a whiteout is still extractable — this does not permanently remove content.
            Use <strong>Redact</strong> to permanently delete content from the document.
          </p>
          <div class="flex items-center gap-2 mt-3 flex-wrap">
            <button
              type="button"
              phx-click="switch_to_redact"
              class="px-3 py-1.5 text-xs font-medium bg-accent text-white rounded-lg hover:bg-accent/90 transition-colors cursor-pointer"
            >
              Redact instead
            </button>
            <button
              type="button"
              phx-click="dismiss_whiteout_permanently"
              class="px-3 py-1.5 text-xs text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-800 rounded-lg transition-colors cursor-pointer"
            >
              Don't show this warning again
            </button>
            <button
              type="button"
              phx-click="dismiss_whiteout_warning"
              class="px-3 py-1.5 text-xs text-amber-600 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-amber-800 rounded-lg transition-colors cursor-pointer"
            >
              Dismiss
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      :if={@show_ocr_prompt}
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 max-w-lg w-full bg-white dark:bg-gray-800 border border-blue-300 dark:border-blue-700 rounded-xl shadow-xl p-4"
      role="alert"
      aria-live="polite"
    >
      <div class="flex items-start gap-3">
        <.icon
          name="hero-document-magnifying-glass"
          class="size-5 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5"
        />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 dark:text-gray-100">
            This document has no text layer
          </p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">
            Search, edit, and other text operations won&#39;t work without a text layer.
            Run OCR to make this document searchable and editable.
          </p>
          <div class="flex items-center gap-2 mt-3 flex-wrap">
            <button
              type="button"
              phx-click="run_ocr"
              disabled={@ocr_running}
              class={[
                "px-3 py-1.5 text-xs font-medium rounded-lg transition-colors cursor-pointer",
                if(@ocr_running,
                  do: "bg-gray-300 text-gray-500 cursor-not-allowed",
                  else: "bg-accent text-white hover:bg-accent/90"
                )
              ]}
            >
              <.icon
                name="hero-arrow-path"
                class={"size-3.5 inline" <> if(@ocr_running, do: " animate-spin", else: "")}
              />
              <span class="ml-1">{if @ocr_running, do: "OCR running…", else: "Run OCR"}</span>
            </button>
            <button
              type="button"
              phx-click="dismiss_ocr_prompt"
              class="px-3 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors cursor-pointer"
            >
              Dismiss
            </button>
          </div>
        </div>
        <button
          type="button"
          phx-click="dismiss_ocr_prompt"
          aria-label="Close"
          class="shrink-0 p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer"
        >
          <.icon name="hero-x-mark" class="size-4 text-gray-500 dark:text-gray-400" />
        </button>
      </div>
    </div>

    <.shortcuts_modal :if={@show_shortcuts} on_close="close_shortcuts" />

    <.live_component
      :if={@show_activate_modal}
      module={QuireWeb.ActivateModal}
      id="activate-modal"
      current_scope={@current_scope}
    />

    <.modal
      :if={@show_merge_wizard}
      title="Merge PDFs"
      on_close="close_merge_wizard"
      open={@show_merge_wizard}
      size="large"
    >
      <div id="merge-wizard" class="space-y-4">
        <%!-- Drop zone / file picker --%>
        <div
          phx-drop-target={@uploads.merge_files.ref}
          class="flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-chrome-border dark:border-gray-600 p-6 text-center hover:border-accent/60 transition-colors"
        >
          <.live_file_input upload={@uploads.merge_files} class="sr-only" />
          <.icon name="hero-document-plus" class="size-8 text-gray-300 dark:text-gray-600" />
          <p class="text-sm text-gray-600 dark:text-gray-300">
            Drop PDFs here or click to browse
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-500">
            Up to 12 files · 50 MB each · 200 MB total
          </p>
        </div>

        <div
          :for={{err, name} <- upload_errors(@uploads.merge_files)}
          class="text-xs text-red-500"
        >
          {name}: {merge_upload_error(err)}
        </div>

        <%!-- File list with drag-reorder + per-file ranges --%>
        <div :if={@merge_files != []} id="merge-file-list" phx-hook=".MergeDrag" class="space-y-2">
          <div
            :for={{item, idx} <- Enum.with_index(@merge_files)}
            id={"merge-item-" <> item.id}
            data-merge-draggable="true"
            data-merge-id={item.id}
            draggable="true"
            class="flex items-center gap-3 rounded-lg border border-chrome-border dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-2"
          >
            <span class="cursor-grab text-gray-400 select-none" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 16 16" fill="currentColor"><circle
                cx="5"
                cy="3"
                r="1.5"
              /><circle cx="11" cy="3" r="1.5" /><circle cx="5" cy="8" r="1.5" /><circle
                cx="11"
                cy="8"
                r="1.5"
              /><circle cx="5" cy="13" r="1.5" /><circle cx="11" cy="13" r="1.5" /></svg>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-800 dark:text-gray-100 truncate">
                {item.name}
              </p>
              <p class="text-xs text-gray-400 dark:text-gray-500">
                {item.pages} page{if item.pages == 1, do: "", else: "s"}
              </p>
            </div>
            <input
              type="text"
              id={"merge-range-" <> item.id}
              name={item.id}
              value={item.range}
              phx-change="merge_set_range"
              placeholder="range, e.g. 1-3,5 (blank = all)"
              aria-label={"Page range for " <> item.name}
              class="w-44 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1 text-xs text-gray-700 dark:text-gray-200"
            />
            <div class="flex items-center gap-0.5">
              <button
                type="button"
                phx-click="merge_move_file"
                phx-value-id={item.id}
                phx-value-dir="up"
                disabled={idx == 0}
                aria-label={"Move " <> item.name <> " up"}
                class="p-1 rounded text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 disabled:opacity-30"
              >
                <.icon name="hero-chevron-up" class="size-4" />
              </button>
              <button
                type="button"
                phx-click="merge_move_file"
                phx-value-id={item.id}
                phx-value-dir="down"
                disabled={idx == length(@merge_files) - 1}
                aria-label={"Move " <> item.name <> " down"}
                class="p-1 rounded text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 disabled:opacity-30"
              >
                <.icon name="hero-chevron-down" class="size-4" />
              </button>
              <button
                type="button"
                phx-click="merge_remove_file"
                phx-value-id={item.id}
                aria-label={"Remove " <> item.name}
                class="p-1 rounded text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30"
              >
                <.icon name="hero-x-mark" class="size-4" />
              </button>
            </div>
          </div>
        </div>

        <%!-- Options --%>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-1 text-sm">
          <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <input
              type="checkbox"
              id="merge-numbering"
              checked={@merge_numbering}
              phx-click="merge_toggle_numbering"
              class="size-4 rounded border-gray-300 text-accent focus:ring-accent/40"
            />
            <span class="text-gray-700 dark:text-gray-200">Continue page numbering</span>
          </label>

          <label class="inline-flex items-center gap-2">
            <span class="text-gray-700 dark:text-gray-200">Bookmarks</span>
            <select
              id="merge-bookmarks"
              phx-change="merge_set_bookmarks"
              class="rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1 text-sm text-gray-700 dark:text-gray-200"
            >
              <option value="keep" selected={@merge_bookmarks == "keep"}>Keep</option>
              <option value="flatten" selected={@merge_bookmarks == "flatten"}>Flatten</option>
            </select>
          </label>

          <label class="inline-flex items-center gap-2">
            <span class="text-gray-700 dark:text-gray-200">Forms</span>
            <select
              id="merge-forms"
              phx-change="merge_set_forms"
              class="rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1 text-sm text-gray-700 dark:text-gray-200"
            >
              <option value="keep" selected={@merge_forms == "keep"}>Keep</option>
              <option value="discard" selected={@merge_forms == "discard"}>Discard</option>
            </select>
          </label>
        </div>

        <div :if={@merge_error} class="text-sm text-red-500" role="alert">
          {@merge_error}
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_merge_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="merge-submit-btn"
            phx-click="merge_submit"
            disabled={@merge_files == [] || @merge_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <.icon :if={@merge_running} name="hero-arrow-path" class="size-4 animate-spin" />
            <span>Merge PDFs</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_split_wizard}
      title="Split PDF"
      on_close="close_split_wizard"
      open={@show_split_wizard}
    >
      <div id="split-wizard" class="space-y-4">
        <div>
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5">
            Split mode
          </label>
          <select
            id="split-mode"
            phx-change="split_set_mode"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="every_n" selected={@split_mode == "every_n"}>Every N pages</option>
            <option value="bookmarks" selected={@split_mode == "bookmarks"}>At bookmarks</option>
            <option value="ranges" selected={@split_mode == "ranges"}>By page ranges</option>
            <option value="file_size" selected={@split_mode == "file_size"}>By file size</option>
            <option value="extract" selected={@split_mode == "extract"}>
              Extract selected pages
            </option>
          </select>
        </div>

        <div :if={@split_mode == "every_n"} id="split-param-every-n">
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="split-n">
            Pages per part
          </label>
          <input
            id="split-n"
            type="number"
            min="1"
            value={@split_n}
            phx-change="split_set_param"
            name="n"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
        </div>

        <div :if={@split_mode == "bookmarks"} id="split-param-bookmarks">
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="split-level">
            Bookmark level
          </label>
          <select
            id="split-level"
            phx-change="split_set_param"
            name="level"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="1" selected={@split_level == "1"}>Top level</option>
            <option value="2" selected={@split_level == "2"}>Second level</option>
            <option value="3" selected={@split_level == "3"}>Third level</option>
          </select>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
            Each top-level bookmark starts a new part.
          </p>
        </div>

        <div :if={@split_mode == "ranges"} id="split-param-ranges">
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="split-ranges">
            Page ranges (one part per range)
          </label>
          <input
            id="split-ranges"
            type="text"
            value={@split_ranges}
            phx-change="split_set_param"
            name="ranges"
            placeholder="e.g. 1-3,5,7-9"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
        </div>

        <div :if={@split_mode == "file_size"} id="split-param-size">
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="split-size">
            Target size per part
          </label>
          <select
            id="split-size"
            phx-change="split_set_param"
            name="size"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="100kb" selected={@split_size == "100kb"}>100 KB</option>
            <option value="500kb" selected={@split_size == "500kb"}>500 KB</option>
            <option value="1mb" selected={@split_size == "1mb"}>1 MB</option>
            <option value="5mb" selected={@split_size == "5mb"}>5 MB</option>
            <option value="10mb" selected={@split_size == "10mb"}>10 MB</option>
            <option value="50mb" selected={@split_size == "50mb"}>50 MB</option>
          </select>
        </div>

        <div :if={@split_mode == "extract"} id="split-param-extract">
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="split-extract">
            Pages to extract
          </label>
          <input
            id="split-extract"
            type="text"
            value={@split_extract}
            phx-change="split_set_param"
            name="extract"
            placeholder="e.g. 1,4,7"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
            Each selected page becomes its own PDF in the ZIP.
          </p>
        </div>

        <div :if={@split_error} class="text-sm text-red-500" role="alert">
          {@split_error}
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_split_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="split-submit-btn"
            phx-click="split_submit"
            disabled={@split_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <.icon :if={@split_running} name="hero-arrow-path" class="size-4 animate-spin" />
            <span>Split to ZIP</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_compress_wizard}
      title="Compress PDF"
      on_close="close_compress_wizard"
      open={@show_compress_wizard}
      size="large"
    >
      <div id="compress-wizard" class="space-y-4">
        <div>
          <label
            class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
            for="compress-preset"
          >
            Preset
          </label>
          <select
            id="compress-preset"
            phx-change="compress_set_preset"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="low" selected={@compress_preset == "low"}>
              Low — best quality (85, up to 4096 px)
            </option>
            <option value="medium" selected={@compress_preset == "medium"}>
              Medium — balanced (70, up to 2048 px)
            </option>
            <option value="high" selected={@compress_preset == "high"}>
              High — smaller file (50, up to 1024 px)
            </option>
            <option value="custom" selected={@compress_preset == "custom"}>Custom…</option>
          </select>
        </div>

        <div
          :if={@compress_preset == "custom"}
          id="compress-custom-params"
          class="grid grid-cols-2 gap-3"
        >
          <div>
            <label
              class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
              for="compress-quality"
            >
              JPEG quality (1–100)
            </label>
            <input
              id="compress-quality"
              type="number"
              min="1"
              max="100"
              value={@compress_custom_quality}
              phx-change="compress_set_param"
              name="quality"
              class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
            />
          </div>
          <div>
            <label
              class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
              for="compress-max-width"
            >
              Max image width (px)
            </label>
            <input
              id="compress-max-width"
              type="number"
              min="1"
              value={@compress_custom_max_width}
              phx-change="compress_set_param"
              name="max_width"
              class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
            />
          </div>
        </div>

        <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
          <input
            type="checkbox"
            id="compress-remove-a11y"
            checked={@compress_remove_a11y}
            phx-click="compress_toggle_a11y"
            class="size-4 rounded border-gray-300 text-accent focus:ring-accent/40"
          />
          <span class="text-gray-700 dark:text-gray-200">Remove accessibility tags</span>
          <span class="text-xs text-gray-400 dark:text-gray-500">
            (strips /StructTreeRoot and /MarkInfo — off by default to keep tagged PDFs accessible)
          </span>
        </label>

        <div :if={@compress_error} class="text-sm text-red-500" role="alert">
          {@compress_error}
        </div>

        <div
          :if={@compress_preview}
          id="compress-preview"
          class="rounded-xl border border-chrome-border dark:border-gray-700 p-4 space-y-3"
        >
          <div class="flex items-baseline gap-3 text-sm">
            <span class="text-gray-500 dark:text-gray-400">Before:</span>
            <span class="font-medium text-gray-800 dark:text-gray-100">{format_bytes(
              @compress_preview.before_size
            )}</span>
            <span class="text-gray-400">→</span>
            <span class="text-gray-500 dark:text-gray-400">After:</span>
            <span class="font-medium text-emerald-600 dark:text-emerald-400">{format_bytes(
              @compress_preview.after_size
            )}</span>
            <span class="text-xs text-gray-400 dark:text-gray-500">
              ({@compress_preview.pct}% smaller)
            </span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">Page 1 — before</p>
              <img
                :if={@compress_preview.before_png}
                id="compress-preview-before"
                src={@compress_preview.before_png}
                alt="Page 1 before compression"
                class="rounded-lg border border-chrome-border dark:border-gray-700 max-h-64"
              />
            </div>
            <div>
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">Page 1 — after</p>
              <img
                :if={@compress_preview.after_png}
                id="compress-preview-after"
                src={@compress_preview.after_png}
                alt="Page 1 after compression"
                class="rounded-lg border border-chrome-border dark:border-gray-700 max-h-64"
              />
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_compress_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="compress-preview-btn"
            phx-click="compress_preview"
            disabled={@compress_running}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors disabled:opacity-50"
          >
            <.icon :if={@compress_running} name="hero-arrow-path" class="size-4 animate-spin" />
            <span>Preview</span>
          </button>
          <button
            type="button"
            id="compress-commit-btn"
            phx-click="compress_commit"
            disabled={@compress_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span>Compress</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_pdfa_wizard}
      title="PDF/A — best-effort conversion"
      on_close="close_pdfa_wizard"
      open={@show_pdfa_wizard}
      size="large"
    >
      <div id="pdfa-wizard" class="space-y-4">
        <p class="text-sm text-gray-600 dark:text-gray-300">
          This is a <span class="font-medium">best-effort conversion</span> to PDF/A-2b:
          the product never claims ISO certification. The structural conformance
          report below lists what was fixed and what could not be verified.
        </p>

        <div :if={@pdfa_error} class="text-sm text-red-500" role="alert">
          {@pdfa_error}
        </div>

        <div
          :if={@pdfa_report}
          id="pdfa-report"
          class="rounded-xl border border-chrome-border dark:border-gray-700 overflow-hidden"
        >
          <div class="px-4 py-2 border-b border-chrome-border dark:border-gray-700 bg-gray-50 dark:bg-gray-900 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700 dark:text-gray-200">
              Conformance report — PDF/A-{@pdfa_report.level}
            </span>
            <span class="text-[11px] text-gray-400 uppercase tracking-wide">best-effort</span>
          </div>
          <ul class="divide-y divide-chrome-border dark:divide-gray-700">
            <li
              :for={check <- @pdfa_report.checks}
              class="flex items-start gap-3 px-4 py-2.5 text-sm"
            >
              <span class={[
                "mt-0.5 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium",
                check.status == :pass &&
                  "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
                check.status == :fail &&
                  "bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300",
                check.status == :not_verified &&
                  "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300"
              ]}>
                {check.status |> to_string() |> String.replace("_", " ")}
              </span>
              <div class="min-w-0">
                <p class="font-medium text-gray-800 dark:text-gray-100">{check.name}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">{check.detail}</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_pdfa_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Close
          </button>
          <button
            type="button"
            id="pdfa-convert-btn"
            phx-click="pdfa_convert"
            disabled={@pdfa_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <.icon :if={@pdfa_running} name="hero-arrow-path" class="size-4 animate-spin" />
            <span>Convert to PDF/A</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_search_redact_wizard}
      title="Search &amp; Redact"
      on_close="close_search_redact_wizard"
      open={@show_search_redact_wizard}
      size="large"
    >
      <div id="search-redact-wizard" class="space-y-4">
        <p class="text-sm text-gray-600 dark:text-gray-300">
          Search the whole document for text to permanently remove. Presets find common
          personal data (SSN, credit card, email, phone, IBAN); you can also search a
          literal string or a regular expression. Review every hit and accept only the
          ones you want redacted — redaction is <span class="font-semibold">permanent and
          unrecoverable</span>.
        </p>

        <div :if={@search_redact_error} class="text-sm text-red-600" role="alert">
          {@search_redact_error}
        </div>

        <%!-- Preset buttons --%>
        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
            Presets
          </span>
          <div class="flex flex-wrap gap-2">
            <button
              :for={{name, label, _regex} <- @search_redact_presets}
              type="button"
              phx-click="search_redact_preset"
              phx-value-preset={name}
              id={"sr-preset-" <> to_string(name)}
              class={[
                "px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors cursor-pointer",
                @search_redact_preset == to_string(name) &&
                  "bg-accent text-white border-accent",
                @search_redact_preset != to_string(name) &&
                  "border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
              ]}
            >
              {label}
            </button>
          </div>
        </div>

        <%!-- Query input --%>
        <div class="flex items-end gap-2">
          <div class="flex-1">
            <label
              class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"
              for="search-redact-query"
            >
              {if @search_redact_preset,
                do: "Custom query (preset selected)",
                else: "Literal or regex query"}
            </label>
            <input
              id="search-redact-query"
              type="text"
              value={@search_redact_query}
              phx-change="search_redact_query_changed"
              placeholder="Search text…"
              class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
            />
          </div>
          <label class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-300 pb-2.5">
            <input
              type="checkbox"
              checked={@search_redact_regex}
              phx-click="search_redact_toggle_regex"
              class="rounded border-chrome-border dark:border-gray-600"
            /> Regex
          </label>
          <button
            type="button"
            id="search-redact-run-btn"
            phx-click="search_redact_run"
            disabled={@search_redact_running}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <.icon
              :if={@search_redact_running}
              name="hero-arrow-path"
              class="size-4 animate-spin"
            />
            <span>Search</span>
          </button>
        </div>

        <%!-- Progress while searching a large document --%>
        <div
          :if={@search_redact_running}
          class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400"
          id="search-redact-progress"
        >
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          Searching across {@total_pages} pages… (you can keep working — this runs in the
          background)
        </div>

        <%!-- Hit review list --%>
        <div :if={@search_redact_hits != []}>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700 dark:text-gray-200">
              {length(@search_redact_hits)} hit(s) — {@search_redact_hits
              |> Enum.count(& &1.accepted)} accepted
            </span>
            <div class="flex items-center gap-2">
              <button
                type="button"
                phx-click="search_redact_accept_all"
                class="text-xs text-accent hover:underline cursor-pointer"
              >
                Accept all
              </button>
              <button
                type="button"
                phx-click="search_redact_reject_all"
                class="text-xs text-gray-500 hover:underline cursor-pointer"
              >
                Reject all
              </button>
            </div>
          </div>
          <div
            id="search-redact-hits"
            class="max-h-72 overflow-y-auto rounded-xl border border-chrome-border dark:border-gray-700 divide-y divide-chrome-border dark:divide-gray-700"
          >
            <label
              :for={hit <- @search_redact_hits}
              class="flex items-start gap-3 px-3 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer"
              id={"sr-hit-" <> hit.id}
            >
              <input
                type="checkbox"
                class="mt-1 rounded border-chrome-border dark:border-gray-600"
                checked={hit.accepted}
                phx-click="search_redact_toggle"
                phx-value-id={hit.id}
                aria-label={"Accept hit on page " <> Integer.to_string(hit.page + 1)}
              />
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
                  <span>Page {hit.page + 1}</span>
                  <span :if={hit.preset}>· {label_for_preset(hit.preset)}</span>
                </div>
                <p class="text-sm font-medium text-gray-800 dark:text-gray-100 break-all">
                  {hit.text}
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400 truncate">{hit.snippet}</p>
              </div>
            </label>
          </div>
        </div>

        <div
          :if={@search_redact_hits == [] and not @search_redact_running}
          class="text-sm text-gray-400"
          id="search-redact-empty"
        >
          Run a search to list hits here.
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_search_redact_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Close
          </button>
          <button
            type="button"
            id="search-redact-apply-btn"
            phx-click="search_redact_apply"
            disabled={
              @search_redact_applying or
                length(accepted_search_redact_hits(@search_redact_hits)) == 0
            }
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-red-600 text-white hover:bg-red-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <.icon
              :if={@search_redact_applying}
              name="hero-arrow-path"
              class="size-4 animate-spin"
            />
            <span>Redact accepted ({length(accepted_search_redact_hits(@search_redact_hits))})</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_blank_wizard}
      title="New blank document"
      on_close="close_blank_wizard"
      open={@show_blank_wizard}
    >
      <div id="blank-wizard" class="space-y-4">
        <div>
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="blank-size">
            Page size
          </label>
          <select
            id="blank-size"
            phx-change="blank_set_size"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="a4" selected={@blank_size == "a4"}>A4</option>
            <option value="letter" selected={@blank_size == "letter"}>Letter</option>
            <option value="legal" selected={@blank_size == "legal"}>Legal</option>
          </select>
        </div>

        <div>
          <span class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5">Orientation</span>
          <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Orientation">
            <button
              type="button"
              id="blank-orientation-portrait"
              role="radio"
              aria-checked={@blank_orientation == "portrait"}
              aria-label="Portrait"
              phx-click="blank_set_orientation"
              phx-value-orientation="portrait"
              class={[
                "px-3 py-2 rounded-lg border text-sm transition-colors",
                if(@blank_orientation == "portrait",
                  do: "border-accent bg-accent/10 text-accent",
                  else:
                    "border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
                )
              ]}
            >
              Portrait
            </button>
            <button
              type="button"
              id="blank-orientation-landscape"
              role="radio"
              aria-checked={@blank_orientation == "landscape"}
              aria-label="Landscape"
              phx-click="blank_set_orientation"
              phx-value-orientation="landscape"
              class={[
                "px-3 py-2 rounded-lg border text-sm transition-colors",
                if(@blank_orientation == "landscape",
                  do: "border-accent bg-accent/10 text-accent",
                  else:
                    "border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
                )
              ]}
            >
              Landscape
            </button>
          </div>
        </div>

        <div :if={@blank_error} class="text-sm text-red-500" role="alert">
          {@blank_error}
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_blank_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="blank-create-btn"
            phx-click="blank_create"
            class="px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors"
          >
            Create
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_template_wizard}
      title="New from template"
      on_close="close_template_wizard"
      open={@show_template_wizard}
    >
      <div id="template-wizard" class="space-y-4">
        <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Template">
          <.template_card
            :for={template <- Quire.Blank.templates()}
            template={template}
            selected={@template_id == template.id}
          />
        </div>

        <div :if={@template_error} class="text-sm text-red-500" role="alert">
          {@template_error}
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_template_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="template-create-btn"
            phx-click="template_create"
            class="px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors"
          >
            Create
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_url_wizard}
      title="URL to PDF"
      on_close="close_url_wizard"
      open={@show_url_wizard}
    >
      <div id="url-wizard" class="space-y-4">
        <p class="text-sm text-gray-600 dark:text-gray-300">
          Print a web page to PDF via the system Chromium. Private, loopback
          and cloud-metadata addresses are blocked for security.
        </p>
        <div>
          <label class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5" for="url-input">
            Page URL
          </label>
          <input
            id="url-input"
            type="text"
            value={@url_value}
            phx-change="url_set"
            name="url"
            placeholder="https://example.com"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
        </div>
        <div :if={@url_error} class="text-sm text-red-500" role="alert">
          {@url_error}
        </div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_url_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="url-convert-btn"
            phx-click="url_convert"
            disabled={@url_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span>Convert to PDF</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_export_image_wizard}
      title="PDF to Image"
      on_close="close_export_image_wizard"
      open={@show_export_image_wizard}
    >
      <div id="export-image-wizard" class="space-y-4">
        <div>
          <label
            class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
            for="export-image-format"
          >
            Format
          </label>
          <select
            id="export-image-format"
            phx-change="export_image_set_format"
            class="w-full rounded-lg border border-chrome-border dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          >
            <option value="png" selected={@export_image_format == "png"}>PNG</option>
            <option value="jpeg" selected={@export_image_format == "jpeg"}>JPEG</option>
            <option value="tiff" selected={@export_image_format == "tiff"}>TIFF</option>
            <option value="webp" selected={@export_image_format == "webp"}>WebP</option>
          </select>
        </div>
        <div>
          <label
            class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
            for="export-image-dpi"
          >
            Resolution (72–600 DPI)
          </label>
          <input
            id="export-image-dpi"
            type="number"
            min="72"
            max="600"
            value={@export_image_dpi}
            phx-change="export_image_set_dpi"
            name="dpi"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
        </div>
        <div>
          <label
            class="block text-sm text-gray-700 dark:text-gray-200 mb-1.5"
            for="export-image-range"
          >
            Pages (blank = all, e.g. 1-3,5)
          </label>
          <input
            id="export-image-range"
            type="text"
            value={@export_image_range}
            phx-change="export_image_set_range"
            name="range"
            placeholder="all"
            class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200"
          />
        </div>
        <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
          <input
            type="checkbox"
            id="export-image-multipage"
            checked={@export_image_multipage}
            phx-click="export_image_toggle_multipage"
            class="size-4 rounded border-gray-300 text-accent focus:ring-accent/40"
          />
          <span class="text-gray-700 dark:text-gray-200">Multipage TIFF</span>
          <span class="text-xs text-gray-400 dark:text-gray-500">(TIFF only)</span>
        </label>
        <div :if={@export_image_error} class="text-sm text-red-500" role="alert">
          {@export_image_error}
        </div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            phx-click="close_export_image_wizard"
            class="px-4 py-2 rounded-lg text-sm font-medium border border-chrome-border dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="export-image-submit-btn"
            phx-click="export_image_submit"
            disabled={@export_image_running}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span>Export</span>
          </button>
        </div>
      </div>
    </.modal>

    <.modal
      :if={@show_camera_capture}
      title="Scan to PDF"
      on_close="close_camera_capture"
      open={@show_camera_capture}
    >
      <.live_component
        module={QuireWeb.CameraCaptureComponent}
        id="camera-capture"
        title="Scan"
      />
    </.modal>

    <%!-- Hidden upload form triggered by the Image OCR ribbon button --%>
    <form
      id="image-ocr-upload-form"
      phx-submit="upload_image_ocr_submit"
      class="hidden"
      phx-hook=".ImageFileTrigger"
    >
      <.live_file_input
        upload={@uploads.image}
        id="image-ocr-upload-input"
        accept="image/png,image/jpeg,image/webp"
      />
    </form>

    <form
      id="insert-pdf-upload-form"
      phx-submit="insert_pdf_submit"
      class="hidden"
      phx-hook=".InsertPdfFileTrigger"
    >
      <.live_file_input
        upload={@uploads.insert_pdf}
        id="insert-pdf-upload-input"
        accept="application/pdf"
      />
    </form>

    <%!-- Hidden upload form triggered by the File to PDF ribbon button (§9.2) --%>
    <form
      id="file-to-pdf-upload-form"
      phx-submit="file_to_pdf_submit"
      class="hidden"
      phx-hook=".FileToPdfTrigger"
    >
      <.live_file_input
        upload={@uploads.file_to_pdf}
        id="file-to-pdf-upload-input"
        accept=".png,.jpg,.jpeg,.tiff,.tif,.bmp,.webp,.gif,.heic,.txt,.md,.csv,.docx,.xlsx,.pptx,.odt,.ods,.odp,.rtf,.html"
      />
    </form>

    <%!-- T-086: operation status strip (live via PubSub broadcasts) --%>
    <div
      :if={Enum.any?(@op_toasts, fn {_id, t} -> t.status == "running" end)}
      id="op-status-strip"
      class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2 rounded-full border border-chrome-border dark:border-gray-600 bg-chrome-white dark:bg-gray-800 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-300 shadow-lg"
      role="status"
      aria-live="polite"
    >
      <.icon name="hero-arrow-path" class="size-3.5 animate-spin text-accent" />
      <span>
        {Enum.count(@op_toasts, fn {_id, t} -> t.status == "running" end)} operation{if Enum.count(
                                                                                          @op_toasts,
                                                                                          fn {_id,
                                                                                              t} ->
                                                                                            t.status ==
                                                                                              "running"
                                                                                          end
                                                                                        ) == 1,
                                                                                        do: "",
                                                                                        else: "s"} running
      </span>
    </div>

    <%!-- T-086: operation progress toasts --%>
    <div id="op-toasts" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 items-end">
      <.progress_toast
        :for={{id, toast} <- @op_toasts}
        id={"op-toast-" <> id}
        message={toast.message}
        progress={toast.pct}
        status={toast.status}
        on_dismiss={JS.push("dismiss_op_toast", value: %{"id" => id})}
      />
    </div>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".KeyboardShortcuts">
      export default {
        mounted() {
          // Focus the shell so phx-keydown fires without the user clicking first
          this.el.focus();

          // Refocus the shell on any click outside form fields, so typing
          // in an input keeps its events while chrome shortcuts stay live
          document.addEventListener("click", (e) => {
            if (e.target.tagName !== "INPUT" && e.target.tagName !== "SELECT" && e.target.tagName !== "TEXTAREA") {
              this.el.focus();
            }
          });

          // The §8.5 keymap claims combos the browser reserves (⌘O/S/P,
          // ⌘F/G, zoom). Swallow the browser default when focus is not in
          // an editable element so the keypress reaches the server instead.
          const reserved = ["o", "s", "p", "f", "g", "z", "y", "a", "=", "+", "-", "0", "1"];
          document.addEventListener("keydown", (e) => {
            if (!(e.ctrlKey || e.metaKey)) return;
            if (!reserved.includes(e.key.toLowerCase())) return;
            if (e.target.closest("input, select, textarea, [contenteditable]")) return;
            e.preventDefault();
          }, true);
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".ImageFileTrigger">
      export default {
        mounted() {
          this.handleEvent("trigger_image_picker", () => {
            // live_file_input overrides its id with the upload ref.
            const input = this.el.querySelector('input[type="file"]');
            if (input) input.click();
          });
        }
      }
    </script>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".InsertPdfFileTrigger">
      export default {
        mounted() {
          this.handleEvent("trigger_insert_pdf_picker", () => {
            const input = this.el.querySelector('input[type="file"]');
            if (input) input.click();
          });
        }
      }
    </script>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".FileToPdfTrigger">
      export default {
        mounted() {
          this.handleEvent("trigger_file_to_pdf_picker", () => {
            const input = this.el.querySelector('input[type="file"]');
            if (input) input.click();
          });
        }
      }
    </script>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".DownloadFile">
      export default {
        mounted() {
          this.handleEvent("download", ({ content, filename, content_type }) => {
            const byteString = atob(content);
            const ab = new ArrayBuffer(byteString.length);
            const ia = new Uint8Array(ab);
            for (let i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
            const blob = new Blob([ab], { type: content_type || "application/octet-stream" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          });
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".CameraCapture">
      export default {
        mounted() {
          this._stream = null;
          this._video = null;
          this._canvas = document.createElement("canvas");
          this._ctx = this._canvas.getContext("2d");
          this._edgeCanvas = null;
          this._edgeCtx = null;
          this._frameCanvas = document.createElement("canvas");
          this._frameCtx = this._frameCanvas.getContext("2d");
          this._raf = null;
          this._clickHandler = null;
        },

        destroyed() {
          this.stopCamera();
          this._removeClickHandler();
          this._canvas = null;
          this._ctx = null;
          this._frameCanvas = null;
          this._frameCtx = null;
        },

        updated() {
          // Check for video element → camera should start
          const video = this.el.querySelector("video[id^=camera-preview-");
          if (video && !this._stream) {
            this._video = video;
            const overlay = this.el.querySelector("canvas[id^=edge-overlay-");
            if (overlay) {
              this._edgeCanvas = overlay;
              this._edgeCtx = overlay.getContext("2d");
            }
            this.startCamera();
          }

          // Bind click handler to the capture button when in capturing phase
          const captureBtn = this.el.querySelector("button[id^=capture-btn-");
          if (captureBtn && !this._clickHandler) {
            this._clickHandler = (e) => {
              e.preventDefault();
              this.capture();
            };
            captureBtn.addEventListener("click", this._clickHandler);
          } else if (!captureBtn && this._clickHandler) {
            this._removeClickHandler();
          }

          // No video but stream active → clean up
          if (!video && this._stream) {
            this.stopCamera();
          }
        },

        async startCamera() {
          if (this._stream) return;

          try {
            const width = parseInt(this.el.dataset.cameraWidth) || 1280;
            const height = parseInt(this.el.dataset.cameraHeight) || 720;

            this._stream = await navigator.mediaDevices.getUserMedia({
              video: {
                width: { ideal: width },
                height: { ideal: height },
                facingMode: "environment"
              }
            });

            if (this._video) {
              this._video.srcObject = this._stream;
              await this._video.play();
            }

            this.pushEvent("camera_ready_event", {});
            this._startEdgeLoop();
          } catch (err) {
            this.pushEvent("camera_error_event", {
              message: err.name || err.message || "Unknown error"
            });
          }
        },

        stopCamera() {
          if (this._raf) {
            cancelAnimationFrame(this._raf);
            this._raf = null;
          }
          if (this._edgeCtx && this._edgeCanvas) {
            this._edgeCtx.clearRect(0, 0, this._edgeCanvas.width, this._edgeCanvas.height);
          }
          if (this._stream) {
            this._stream.getTracks().forEach(track => track.stop());
            this._stream = null;
          }
          if (this._video) {
            this._video.srcObject = null;
            this._video = null;
          }
          this._removeClickHandler();
        },

        // Live Sobel edge-detection overlay — paints strong edges in green so
        // the user can line the document up with the detected borders (§9.2).
        _startEdgeLoop() {
          if (this._raf) return;
          const tick = () => {
            if (!this._stream || !this._video || !this._edgeCtx) return;
            const vw = this._video.videoWidth || 0;
            const vh = this._video.videoHeight || 0;
            if (vw < 8 || vh < 8) {
              this._raf = requestAnimationFrame(tick);
              return;
            }
            // Process at half resolution, then let CSS scale the overlay.
            const w = Math.floor(vw / 2);
            const h = Math.floor(vh / 2);
            if (this._edgeCanvas.width !== w) this._edgeCanvas.width = w;
            if (this._edgeCanvas.height !== h) this._edgeCanvas.height = h;
            if (this._frameCanvas.width !== w) this._frameCanvas.width = w;
            if (this._frameCanvas.height !== h) this._frameCanvas.height = h;

            this._frameCtx.drawImage(this._video, 0, 0, w, h);
            const src = this._frameCtx.getImageData(0, 0, w, h).data;
            const out = this._edgeCtx.createImageData(w, h);
            const o = out.data;

            // Sobel magnitude; green highlight where the gradient is strong.
            for (let y = 1; y < h - 1; y++) {
              for (let x = 1; x < w - 1; x++) {
                const i = (y * w + x) * 4;
                const l00 = lum(src, i - w * 4 - 4), l10 = lum(src, i - w * 4), l20 = lum(src, i - w * 4 + 4);
                const l01 = lum(src, i - 4),                       l21 = lum(src, i + 4);
                const l02 = lum(src, i + w * 4 - 4), l12 = lum(src, i + w * 4), l22 = lum(src, i + w * 4 + 4);
                const gx = (l20 + 2 * l21 + l22) - (l00 + 2 * l01 + l02);
                const gy = (l02 + 2 * l12 + l22) - (l00 + 2 * l10 + l20);
                const mag = Math.sqrt(gx * gx + gy * gy);
                if (mag > 90) {
                  o[i] = 74; o[i + 1] = 222; o[i + 2] = 128; o[i + 3] = 150;
                }
              }
            }
            this._edgeCtx.putImageData(out, 0, 0);
            this._raf = requestAnimationFrame(tick);
          };
          this._raf = requestAnimationFrame(tick);
        },

        capture() {
          if (!this._stream || !this._video) return;

          const width = this._video.videoWidth || 1280;
          const height = this._video.videoHeight || 720;

          this._canvas.width = width;
          this._canvas.height = height;
          this._ctx.drawImage(this._video, 0, 0, width, height);

          // Encode as JPEG at 90% quality
          const dataUrl = this._canvas.toDataURL("image/jpeg", 0.90);
          this.pushEvent("camera_captured", { dataUrl });
        },

        _removeClickHandler() {
          if (this._clickHandler) {
            const btn = this.el.querySelector("button[id^=capture-btn-");
            if (btn) btn.removeEventListener("click", this._clickHandler);
            this._clickHandler = null;
          }
        }
      }

      function lum(d, i) {
        return 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".MergeDrag">
      export default {
        mounted() {
          this._onDragStart = (e) => {
            const row = e.target.closest("[data-merge-draggable]");
            if (!row) return;
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", row.dataset.mergeId);
            row.classList.add("opacity-50");
          };
          this._onDragEnd = (e) => {
            const row = e.target.closest("[data-merge-draggable]");
            if (row) row.classList.remove("opacity-50");
          };
          this._onDragOver = (e) => {
            if (e.target.closest("[data-merge-draggable]")) e.preventDefault();
          };
          this._onDrop = (e) => {
            const target = e.target.closest("[data-merge-draggable]");
            if (!target) return;
            e.preventDefault();
            const id = e.dataTransfer.getData("text/plain");
            if (id && id !== target.dataset.mergeId) {
              this.pushEvent("merge_move_file", { id, dir: "to", target: target.dataset.mergeId });
            }
          };
          this.el.addEventListener("dragstart", this._onDragStart);
          this.el.addEventListener("dragend", this._onDragEnd);
          this.el.addEventListener("dragover", this._onDragOver);
          this.el.addEventListener("drop", this._onDrop);
        },

        destroyed() {
          this.el.removeEventListener("dragstart", this._onDragStart);
          this.el.removeEventListener("dragend", this._onDragEnd);
          this.el.removeEventListener("dragover", this._onDragOver);
          this.el.removeEventListener("drop", this._onDrop);
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".ScanFileInput">
      export default {
        mounted() {
          this.el.addEventListener("change", (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = () => {
              this.pushEvent("scan_file_ready", {
                dataUrl: reader.result,
                deskew: this.el.dataset.deskew,
                contrast: this.el.dataset.contrast,
                ocr: this.el.dataset.ocr,
                title: file.name.replace(/\.[^.]+$/, "")
              });
            };
            reader.readAsDataURL(file);
            this.el.value = "";
          });
        }
      }
    </script>
  </div>
  <.modal
    :if={@show_add_action}
    title="Add Action"
    on_close="cancel_add_action"
    open={@show_add_action}
    size="large"
  >
    <div id="add-action-modal" class="space-y-4">
      <%!-- Action type card grid (3 cards + ⋮ overflow) --%>
      <div
        id="action-type-grid"
        class="grid grid-cols-3 gap-3"
        role="group"
        aria-label="Action types"
      >
        <%= for {type, label, icon} <- @action_cards do %>
          <button
            type="button"
            id={"action-card-" <> type}
            phx-click="select_action_type"
            phx-value-type={type}
            aria-pressed={@action_type == type}
            class={[
              "flex flex-col items-center gap-2 px-3 py-4 rounded-xl border text-sm transition-all cursor-pointer",
              if(@action_type == type,
                do: "border-accent bg-accent/10 text-accent",
                else:
                  "border-chrome-border dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700"
              )
            ]}
          >
            <.icon name={icon} class="size-5" />
            <span class="text-center text-xs font-medium leading-tight">{label}</span>
          </button>
        <% end %>
      </div>

      <div class="flex items-center justify-end">
        <button
          type="button"
          id="action-overflow-toggle"
          phx-click="toggle_action_overflow"
          aria-expanded={@action_overflow_open}
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm border border-chrome-border dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer"
        >
          <span>More</span> ⋮
        </button>
      </div>

      <div :if={@action_overflow_open} id="action-overflow" class="space-y-1">
        <%= for type <- @action_overflow_types do %>
          <button
            type="button"
            id={"action-overflow-" <> type}
            phx-click="select_action_type"
            phx-value-type={type}
            role="menuitem"
            class={[
              "w-full text-left px-3 py-2 rounded-lg text-sm transition-colors cursor-pointer",
              if(@action_type == type,
                do: "bg-accent/10 text-accent",
                else: "hover:bg-gray-100 dark:hover:bg-gray-700"
              )
            ]}
          >
            {action_type_label(type)}
          </button>
        <% end %>
      </div>

      <%!-- Type-specific form --%>
      <.form for={@action_form} id="add-action-form" phx-submit="apply_action">
        <div id="add-action-fields" class="mt-4 space-y-3">
          <%= if @action_type == "open" do %>
            <div>
              <label
                for="action-url"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                URL
              </label>
              <.input
                type="text"
                id="action-url"
                name="action[url]"
                value={action_field(@action, "url")}
                phx-change="set_action_field"
                placeholder="https://example.com"
                class="mt-1 w-full"
              />
              <div class="mt-1 text-xs text-gray-400 dark:text-gray-500">
                Allowed schemes: {@allowed_schemes_text}
              </div>
            </div>
            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
              <.input
                type="checkbox"
                id="action-new-window"
                name="action[open_in_new_window]"
                value="true"
                checked={action_field(@action, "open_in_new_window") == "true"}
                phx-change="set_action_field"
              /> Open in new window
            </label>
          <% end %>

          <%= if @action_type == "open_file" do %>
            <div>
              <label
                for="action-file"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                File
              </label>
              <.input
                type="text"
                id="action-file"
                name="action[file]"
                value={action_field(@action, "file")}
                phx-change="set_action_field"
                placeholder="Choose an attached or embedded file"
                class="mt-1 w-full"
              />
              <div class="mt-2">
                <button
                  type="button"
                  id="action-file-picker"
                  phx-click="pick_action_file"
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm bg-gray-900 text-white hover:bg-gray-800 transition-colors cursor-pointer"
                >
                  Browse…
                </button>
              </div>
            </div>
          <% end %>

          <%= if @action_type == "page" do %>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  for="action-page-number"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Page number
                </label>
                <.input
                  type="number"
                  id="action-page-number"
                  name="action[page_number]"
                  min="1"
                  value={action_field(@action, "page_number")}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
              <div>
                <label
                  for="action-zoom"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Zoom / fit
                </label>
                <.input
                  type="select"
                  id="action-zoom"
                  name="action[zoom]"
                  value={action_field(@action, "zoom")}
                  options={@zoom_options}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
            </div>
            <div>
              <label
                for="action-named-destination"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                Named destination (optional)
              </label>
              <.input
                type="text"
                id="action-named-destination"
                name="action[named_destination]"
                value={action_field(@action, "named_destination")}
                phx-change="set_action_field"
                class="mt-1 w-full"
              />
            </div>
          <% end %>

          <%= if @action_type == "goto_destination" do %>
            <div>
              <label
                for="action-destination"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                Named destination
              </label>
              <.input
                type="text"
                id="action-destination"
                name="action[name]"
                value={action_field(@action, "name")}
                phx-change="set_action_field"
                class="mt-1 w-full"
              />
            </div>
          <% end %>

          <%= if @action_type == "menu_item" do %>
            <div>
              <label
                for="action-menu-item"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                Menu command
              </label>
              <.input
                type="text"
                id="action-menu-item"
                name="action[name]"
                value={action_field(@action, "name")}
                phx-change="set_action_field"
                placeholder="e.g. HideMenubar, SaveAs, Quit"
                class="mt-1 w-full"
              />
            </div>
          <% end %>

          <%= if @action_type == "submit_form" do %>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  for="action-submit-url"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Submit URL
                </label>
                <.input
                  type="text"
                  id="action-submit-url"
                  name="action[url]"
                  value={action_field(@action, "url")}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
              <div>
                <label
                  for="action-submit-method"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Method
                </label>
                <.input
                  type="select"
                  id="action-submit-method"
                  name="action[method]"
                  value={action_field(@action, "method")}
                  options={@method_options}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
            </div>
          <% end %>

          <%= if @action_type == "reset_form" do %>
            <div class="text-sm text-gray-500 dark:text-gray-400" id="action-reset-note">
              Reset form values when the link is activated.
            </div>
          <% end %>

          <%= if @action_type == "show_hide_field" do %>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  for="action-field-name"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Field name
                </label>
                <.input
                  type="text"
                  id="action-field-name"
                  name="action[field]"
                  value={action_field(@action, "field")}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
              <div>
                <label
                  for="action-field-visibility"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                >
                  Visibility
                </label>
                <.input
                  type="select"
                  id="action-field-visibility"
                  name="action[visibility]"
                  value={action_field(@action, "visibility")}
                  options={@visibility_options}
                  phx-change="set_action_field"
                  class="mt-1 w-full"
                />
              </div>
            </div>
          <% end %>

          <%= if @action_type == "javascript" do %>
            <div class="rounded-xl border border-amber-300 dark:border-amber-600 bg-amber-50 dark:bg-amber-900/20 p-3">
              <label class="flex items-start gap-2 text-sm text-amber-900 dark:text-amber-200">
                <.input
                  type="checkbox"
                  id="action-js-enable"
                  name="js_enabled"
                  value="true"
                  checked={@link_js_enabled}
                  phx-change="set_action_js"
                />
                <span>
                  <span class="font-medium">Enable Run JavaScript</span>
                  <span class="block mt-1 text-xs text-amber-700 dark:text-amber-300">
                    ⚠️ Off by default. If enabled, the script runs only in the
                    viewer via pdf.js PDFScriptingManager + pdf.sandbox.mjs —
                    never on the server.
                  </span>
                </span>
              </label>
            </div>
            <.input
              :if={@link_js_enabled}
              type="textarea"
              id="action-js-code"
              name="action[code]"
              value={action_field(@action, "code")}
              phx-change="set_action_field"
              rows="4"
              placeholder="JavaScript to run in the viewer sandbox"
              class="mt-3 w-full font-mono text-sm"
            />
          <% end %>

          <%= if @action_err do %>
            <div id="add-action-error" class="text-sm text-red-500" role="alert">
              {@action_err}
            </div>
          <% end %>
        </div>

        <div class="mt-6 flex items-center justify-end gap-2">
          <button
            type="button"
            id="add-action-cancel"
            phx-click="cancel_add_action"
            class="px-4 py-2 rounded-lg text-sm border border-chrome-border dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="add-action-apply"
            disabled={not @action_valid}
            class={[
              "px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer",
              if(@action_valid,
                do: "bg-accent text-white hover:opacity-90",
                else: "bg-gray-200 text-gray-400 dark:bg-gray-700 cursor-not-allowed"
              )
            ]}
          >
            Apply
          </button>
        </div>
      </.form>
    </div>
  </.modal>
</Layouts.workspace>
